# Template of .env: copy it to .env and fill in the values. .env is out of git.
# Astro loads .env into the Airflow containers when they start, so run `astro dev restart` after changing it.

# Database (local container). Airflow builds the connection "subastas_db" from this variable.
# User and password are the ones in subastas-db.env. Airflow reaches the container by its name, subastas-db
AIRFLOW_CONN_SUBASTAS_DB=postgresql://subastas:<password>@subastas-db:5432/subastas

# Claude, to read the announcements
ANTHROPIC_API_KEY=<anthropic-api-key>

# Goolzoom, for the Catastro data of each reference
GOOLZOOM_API_KEY=<goolzoom-api-key>

# healthchecks.io check, pinged when the weekly run succeeds or fails
HEALTHCHECK_URL=https://hc-ping.com/<check-uuid>