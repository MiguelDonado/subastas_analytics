# Template of subastas-db.env: copy it to subastas-db.env and fill in the password. subastas-db.env is out of git.
#
# Read by the Postgres image to create the owner user and the database, ONLY on
# the first start (empty data volume). Changing them later does nothing.
POSTGRES_USER=subastas
POSTGRES_DB=subastas
# Must match the password in AIRFLOW_CONN_SUBASTAS_DB in .env. Letters and numbers only,
# since it goes inside a URL there (e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=<password>