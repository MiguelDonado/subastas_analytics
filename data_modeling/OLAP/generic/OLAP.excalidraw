    {
      "id": "2RAy06-NMDezaS69LdI8A",
      "type": "text",
      "x": 699.4593047542454,
      "y": -1100.0826461582747,
      "width": 2033.25,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
