      "isDeleted": true,
      "boundElements": null,
      "updated": 1793716509406,
      "created": 1793716508630,
      "link": null,
      "locked": false,
      "text": "Without spaces, each has 18 characters instead of 20. A\nfull reference ends in two control letters, and these look\nlike they're missing. So they may be real plots that were\nwritten without those letters, not bad data. It's only\none announcement, but half its lots were affected, so\nthis could be common.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Without spaces, each has 18 characters instead of 20. A full reference ends in two control letters, and these look like they're missing. So they may be real plots that were written without those letters, not bad data. It's only one announcement, but half its lots were affected, so this could be common.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
