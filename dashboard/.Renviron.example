# Template of .Renviron: copy it to .Renviron and fill in the values. .Renviron is out of git.
# R loads .Renviron by itself on startup, so restart R after changing it.
# On Posit Connect Cloud these same variables are set in the app's settings, with Neon's values.

# Database (local container), with the app's user
SUBASTAS_DB_HOST=localhost
SUBASTAS_DB_PORT=5436
SUBASTAS_DB_NAME=subastas
SUBASTAS_DB_USER=subastas_app
SUBASTAS_DB_PASSWORD=<subastas_app-password>

# The local container has no encryption. On Neon it's require: only connect if the connection is encrypted
PGSSLMODE=disable